# Keep the build context limited to maintained application and fixture sources.
*
!Dockerfile
!.dockerignore
!pom.xml
!mvnw
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/**
!src/
!src/**
!scripts/
!scripts/integration/
!scripts/integration/**

**/.env
**/.env.*
**/*.pem
**/*.key
**/credentials*
**/secrets*
**/.git
**/.idea
**/.vscode
**/.DS_Store
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.venv
**/target
**/data
**/*.log
