# Copy to a private env file; passwords must be nonblank, URL-safe values.
LUX_DB_PASSWORD=replace-with-local-application-password
LUX_MYSQL_PASSWORD=replace-with-local-root-password
LUX_S3_ACCESS_KEY=lux-local
LUX_S3_SECRET_KEY=replace-with-local-storage-secret
LUX_S3_BUCKET=lux-assets

LUX_BACKEND_PORT=18080
LUX_AGENT_PORT=18000
LUX_CONNECTOR_PORT=18001
LUX_MYSQL_PORT=13306
LUX_KAFKA_PORT=19092
LUX_S3_PORT=18333
